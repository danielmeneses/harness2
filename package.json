{
  "name": "@danielmeneses/harness2",
  "version": "0.1.1",
  "type": "module",
  "description": "Terminal coding agent whose loop belongs to the model",
  "bin": {
    "harness2": "./dist/main.js",
    "h2": "./dist/main.js"
  },
  "scripts": {
    "start": "node src/main.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "mock": "node scripts/mock-model.ts",
    "prepublishOnly": "npm run typecheck && npm test",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/main.js',0o755)\"",
    "prepare": "npm run build",
    "postinstall": "node dist/postinstall.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "files": [
    "dist/**/*.js",
    "README.md"
  ],
  "license": "UNLICENSED",
  "keywords": [
    "agent",
    "coding-agent",
    "cli",
    "llm",
    "terminal",
    "openai-compatible"
  ],
  "main": "./dist/main.js",
  "publishConfig": {
    "access": "public"
  },
  "author": "Daniel Meneses",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielmeneses/harness2.git"
  },
  "homepage": "https://github.com/danielmeneses/harness2#readme",
  "bugs": {
    "url": "https://github.com/danielmeneses/harness2/issues"
  }
}
